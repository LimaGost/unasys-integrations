# ==============================================================
# unasys-integrations - variaveis de ambiente
# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA faca commit do arquivo ".env" (nem cole valores reais aqui
# neste .env.example - ele fica versionado).
# ==============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base44 SDK (app hospedado no Base44: Unasys Tickets) ---
# ID do app, encontrado na URL do editor Base44 (entre "/apps/" e "/editor/").
BASE44_APP_ID=
# Credenciais de uma conta de usuario dedicada a esta integracao, criada no
# app Base44 (Unasys Tickets) com o role/permissoes minimas necessarias.
# O SDK so oferece "service role" (permissoes elevadas) dentro de backend
# functions hospedadas no proprio Base44 - backends externos como este devem
# autenticar como um usuario comum via loginViaEmailPassword.
BASE44_SERVICE_ACCOUNT_EMAIL=
BASE44_SERVICE_ACCOUNT_PASSWORD=

# --- Autenticacao dos webhooks e credenciais do Gmail ---
# IMPORTANTE: estas variaveis so sao lidas na TODA primeira vez que o servico
# sobe (para semear data/integrations-config.json). Depois disso, o arquivo
# de config passa a ser a fonte da verdade, e tudo aqui pode ser gerenciado
# pelo painel (secao "Configuracoes" em /dashboard), sem editar .env nem
# reiniciar o processo. Deixar em branco e configurar tudo direto pelo
# painel na primeira vez que acessar tambem funciona.
#
# Cada rota externa exige um token secreto no header "x-webhook-token".
# Gere valores unicos e aleatorios (ex: openssl rand -hex 32) para cada integracao.
WEBHOOK_TOKEN_GMAIL=
WEBHOOK_TOKEN_SALES_DATA=

# Credenciais do Gmail (SMTP/IMAP via "senha de app" do Google). Enquanto nao
# configuradas (aqui ou pelo painel), as rotas de Gmail respondem 503.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Vertical padrao ao criar um Ticket de suporte a partir de um email
# recebido sem vinculo previo com ticket/cliente existente. Opcional,
# default "geral" se omitido (ver TODO em src/routes/gmail.ts).
GMAIL_DEFAULT_SUPPORT_VERTICAL=geral
# Intervalo (minutos) entre verificacoes automaticas da caixa de entrada.
# Opcional, default 2 se omitido.
GMAIL_POLL_INTERVAL_MINUTES=2

# --- Painel (GET /dashboard) ---
# Login HTTP Basic para ver requisicoes recentes, status e logs no navegador.
# Enquanto nao preenchidas, o painel responde 503 (ver README).
DASHBOARD_USER=
DASHBOARD_PASSWORD=
